// ACTA — Prisma schema
// HU-0.1: 11 tablas + 3 enums. Naming camelCase en DB. UUID v4. Postgres 16+.
// HU-G21: +4 modelos (SesionGrabacion, PasoGrabado, ParametroGrabacion, JuegoDeDatos)
//         +1 enum (CasoOrigen). Extensiones no-breaking a CasoPrueba, Ejecucion, PasoEjecucion.
// Convenciones: Restrict en PKs de evidencia; Cascade en child rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums nativos Postgres
// ============================================================

enum EjecucionEstado {
  pendiente
  corriendo
  paso
  fallo
  reparado
  errorMotor
  cancelado
}

enum PasoEjecucionEstado {
  paso
  fallo
  reparado
}

enum ArtefactoTipo {
  video
  captura
  trace
}

enum CasoOrigen {
  subirScript
  grabador
  mixto
}

// ============================================================
// Entidades de identidad y membresía (HU-1.1, HU-6.1)
// ============================================================

model Usuario {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  rol          String   @default("superadmin")
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  espacios       UsuarioEspacio[]
  casosAsignados CasoPrueba[]      @relation("CasoPruebaResponsable")
  sesiones       SesionGrabacion[]

  @@index([email])
}

model Espacio {
  id        String   @id @default(uuid())
  nombre    String
  color     String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  proyectos Proyecto[]
  miembros  UsuarioEspacio[]
}

model UsuarioEspacio {
  usuarioId String
  espacioId String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  espacio Espacio @relation(fields: [espacioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, espacioId])
  @@index([espacioId])
}

// ============================================================
// Jerarquía espacio → proyecto → caso de prueba (HU-2.x)
// ============================================================

model Proyecto {
  id             String   @id @default(uuid())
  espacioId      String
  nombre         String
  ambiente       String
  descripcion    String?
  versionSistema String?
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  espacio      Espacio           @relation(fields: [espacioId], references: [id], onDelete: Restrict)
  casosPrueba  CasoPrueba[]
  credenciales Credencial[]
  sesiones     SesionGrabacion[]

  @@index([espacioId])
}

model CasoPrueba {
  id             String     @id @default(uuid())
  proyectoId     String
  codigo         String
  nombre         String
  script         String     @db.Text
  scriptFileName String?
  responsableId  String
  origen         CasoOrigen @default(subirScript)
  activo         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(6)

  proyecto      Proyecto             @relation(fields: [proyectoId], references: [id], onDelete: Restrict)
  responsable   Usuario              @relation("CasoPruebaResponsable", fields: [responsableId], references: [id], onDelete: Restrict)
  ejecuciones   Ejecucion[]
  sesiones      SesionGrabacion[]
  pasosGrabados PasoGrabado[]
  parametros    ParametroGrabacion[]
  juegosDeDatos JuegoDeDatos[]

  @@unique([proyectoId, codigo])
  @@index([responsableId])
  @@index([proyectoId])
  @@index([origen])
}

// ============================================================
// Ejecución, pasos, artefactos (HU-3.x, HU-4.x)
// ============================================================

model Ejecucion {
  id               String          @id @default(uuid())
  casoPruebaId     String
  estado           EjecucionEstado
  inicioAt         DateTime?
  finAt            DateTime?
  duracionMs       Int?
  errorMsg         String?
  entorno          String?
  navegador        String?
  sistemaOperativo String?
  nodoEjecucion    String?
  loteId           String?
  asercionesTotal  Int             @default(0)
  asercionesOk     Int             @default(0)
  asercionesFail   Int             @default(0)
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(6)

  casoPrueba  CasoPrueba      @relation(fields: [casoPruebaId], references: [id], onDelete: Restrict)
  pasos       PasoEjecucion[]
  subacciones PasoSubaccion[]
  artefactos  Artefacto[]
  acta        Acta?

  @@index([casoPruebaId])
  @@index([estado])
  @@index([loteId])
}

model PasoEjecucion {
  id                String              @id @default(uuid())
  ejecucionId       String
  numero            Int
  descripcion       String
  estado            PasoEjecucionEstado
  duracionMs        Int?
  selfHealed        Boolean             @default(false)
  errorMsg          String?
  resultadoEsperado String?
  resultadoObtenido String?
  errorCount        Int                 @default(0)
  logs              Json?
  videoInicioMs     Int?
  videoFinMs        Int?
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)

  ejecucion   Ejecucion       @relation(fields: [ejecucionId], references: [id], onDelete: Cascade)
  artefactos  Artefacto[]
  subacciones PasoSubaccion[]

  @@unique([ejecucionId, numero])
  @@index([ejecucionId])
}

model PasoSubaccion {
  id                  String              @id @default(uuid())
  ejecucionId         String
  pasoEjecucionId     String
  numero              Int
  tipo                String              @default("other")
  descripcion         String
  estado              PasoEjecucionEstado
  duracionMs          Int?
  errorMsg            String?
  logs                Json?
  capturaActualId     String?
  capturaReferenciaId String?
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)

  ejecucion         Ejecucion     @relation(fields: [ejecucionId], references: [id], onDelete: Cascade)
  pasoEjecucion     PasoEjecucion @relation(fields: [pasoEjecucionId], references: [id], onDelete: Cascade)
  capturaActual     Artefacto?    @relation("CapturaActual", fields: [capturaActualId], references: [id])
  capturaReferencia Artefacto?    @relation("CapturaReferencia", fields: [capturaReferenciaId], references: [id])

  @@index([ejecucionId])
  @@index([pasoEjecucionId])
}

model Artefacto {
  id              String        @id @default(uuid())
  ejecucionId     String
  pasoEjecucionId String?
  tipo            ArtefactoTipo
  nombre          String
  path            String
  sha256          String
  bytes           Int
  metadata        Json?
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)

  ejecucion          Ejecucion       @relation(fields: [ejecucionId], references: [id], onDelete: Cascade)
  pasoEjecucion      PasoEjecucion?  @relation(fields: [pasoEjecucionId], references: [id], onDelete: SetNull)
  capturasActuales   PasoSubaccion[] @relation("CapturaActual")
  capturasReferencia PasoSubaccion[] @relation("CapturaReferencia")

  @@index([ejecucionId])
  @@index([tipo])
  @@index([pasoEjecucionId])
}

// ============================================================
// Acta de evidencia (HU-5.x) — 1-a-1 con ejecución
// ============================================================

model Acta {
  id          String    @id @default(uuid())
  ejecucionId String    @unique
  consecutivo String    @unique
  rutaPdf     String
  generatedAt DateTime?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  ejecucion Ejecucion @relation(fields: [ejecucionId], references: [id], onDelete: Restrict)
}

// ============================================================
// Credenciales (HU-7.x) — prioridad baja
// ============================================================

model Credencial {
  id            String    @id @default(uuid())
  proyectoId    String
  nombre        String
  tipo          String
  valor         Bytes     @db.ByteA
  sesionVenceAt DateTime?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  proyecto Proyecto          @relation(fields: [proyectoId], references: [id], onDelete: Restrict)
  sesiones SesionGrabacion[]

  @@index([proyectoId])
}

// ============================================================
// Modo grabador — HU-G21
// SesionGrabacion: 1 fila por intento de grabación iniciada.
//   token HMAC persistido para reconexión post-reinicio (tokenUsado=true one-shot).
//   storageState: snapshot Playwright descifrado server-side (no se persiste el `valor`
//   de Credencial; el snapshot se usa solo mientras la sesión está activa).
// ============================================================

model SesionGrabacion {
  id           String    @id @default(uuid())
  proyectoId   String
  usuarioId    String
  casoPruebaId String?
  nombre       String
  urlInicial   String
  ambiente     String
  navegador    String    @default("chromium")
  credencialId String?
  storageState Json?
  token        String?
  tokenUsado   Boolean   @default(false)
  estado       String
  mensajeError String?
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  proyecto   Proyecto             @relation(fields: [proyectoId], references: [id], onDelete: Restrict)
  usuario    Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  casoPrueba CasoPrueba?          @relation(fields: [casoPruebaId], references: [id], onDelete: SetNull)
  credencial Credencial?          @relation(fields: [credencialId], references: [id], onDelete: SetNull)
  pasos      PasoGrabado[]
  parametros ParametroGrabacion[]

  @@index([proyectoId])
  @@index([usuarioId])
  @@index([estado])
  @@index([casoPruebaId])
}

// ============================================================
// PasoGrabado — unidad mínima del modo grabador (HU-G21, HU-G3)
// Cada paso se persiste mientras la grabación está activa; se cablea
// desde el recorder-worker cuando G3 implemente el traductor de eventos.
// ============================================================

model PasoGrabado {
  id                 String   @id @default(uuid())
  sesionId           String
  casoPruebaId       String?
  numero             Int
  tipo               String
  origen             String   @default("grabado")
  descripcion        String
  selectorPrincipal  Json
  selectoresRespaldo Json
  valor              String?
  esValorSensible    Boolean  @default(false)
  assertionKind      String?
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  sesion     SesionGrabacion @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  casoPrueba CasoPrueba?     @relation(fields: [casoPruebaId], references: [id], onDelete: SetNull)

  @@unique([sesionId, numero])
  @@index([sesionId])
  @@index([casoPruebaId])
}

// ============================================================
// ParametroGrabacion — clave/valor capturado durante la grabación (HU-G21, HU-G7)
// `origen='credencial'` indica que el valor proviene de Credencial.valor descifrado.
// ============================================================

model ParametroGrabacion {
  id           String   @id @default(uuid())
  sesionId     String?
  casoPruebaId String?
  nombre       String
  valorDefecto String?
  origen       String
  credencialId String?
  enUso        Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  sesion     SesionGrabacion? @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  casoPrueba CasoPrueba?      @relation(fields: [casoPruebaId], references: [id], onDelete: Cascade)

  @@unique([sesionId, nombre])
  @@index([casoPruebaId])
}

// ============================================================
// JuegoDeDatos — datos tabares para ejecución data-driven (HU-G13, stub)
// ============================================================

model JuegoDeDatos {
  id            String   @id @default(uuid())
  casoPruebaId  String
  nombreArchivo String
  filas         Json
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  casoPrueba CasoPrueba @relation(fields: [casoPruebaId], references: [id], onDelete: Cascade)

  @@index([casoPruebaId])
}

// ============================================================
// Tabla auxiliar — correlativo anual atómico (HU-5.3)
// ============================================================

model ConsecutivoAnual {
  anio   Int @id
  ultimo Int
}
