# Base de datos
DATABASE_URL="postgresql://acta:acta@localhost:5432/acta?schema=public"

# Sesiones (iron-session) — mínimo 32 caracteres
SESSION_SECRET="cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres"

# Semilla de superadmin
SEED_ADMIN_PASSWORD="cambia-esta-contraseña-segura"

# Entorno
NODE_ENV="development"

# ============================================================
# Recorder-worker (HU-G22) — modo grabador
# ============================================================

# Puerto HTTP + WS del recorder-worker
RECORDER_WS_PORT=3100

# URL pública del WS (expuesta al browser del frontend)
RECORDER_PUBLIC_URL=ws://localhost:3100

# Secreto compartido entre Next.js y recorder-worker para /internal/start
# DEBE coincidir en ambos servicios. Generar con: openssl rand -hex 32
RECORDER_INTERNAL_SECRET=""

# Máximo de sesiones de grabación concurrentes (default 3)
RECORDER_MAX_SESSIONS=3

# Timeout de heartbeat en ms (default 600000 = 10 min)
RECORDER_HEARTBEAT_TIMEOUT_MS=600000
