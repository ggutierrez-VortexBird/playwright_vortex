# Variables que docker-compose.dev.yml interpola directamente (sintaxis
# ${VAR:?requerido} / ${VAR:-default} dentro de los bloques `environment:`).
# NO es el set completo de configuración de la app — para correr cada
# subproyecto sin Docker (`npm run dev` desde vortest-web/), usa el
# .env.example propio de esa carpeta (vortest-web/.env.example), que trae
# todas las variables que ese proceso necesita.
#
# Uso: cp .env.example .env && docker compose -f docker-compose.dev.yml up

# Sesiones (iron-session) — mínimo 32 caracteres. Usado por los servicios
# `web` y `recorder`.
SESSION_SECRET="cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres"

# Semilla de superadmin (servicio `web`).
SEED_ADMIN_PASSWORD="cambia-esta-contraseña-segura"

# Secreto compartido entre `web` y `recorder` para el endpoint interno
# /internal/start. DEBE coincidir en ambos servicios. Sin default público:
# si falta, el compose falla duro al arrancar en vez de quedar con un
# secreto conocido (ver [S-09] en mejoras-opus5.md).
# Generar con: openssl rand -hex 32
RECORDER_INTERNAL_SECRET="cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres"

# Máximo de sesiones de grabación concurrentes (servicio `recorder`).
RECORDER_MAX_SESSIONS=3

# Timeout de heartbeat del recorder en ms (servicio `recorder`, default
# 600000 = 10 min).
RECORDER_HEARTBEAT_TIMEOUT_MS=600000

# Secreto compartido entre `web`/`execution-consumer` y `engine` para los
# endpoints internos motor<->app (subida de artefactos, cancelación). DEBE
# coincidir en ambos servicios. Generar con: openssl rand -hex 32
ENGINE_INTERNAL_SECRET="cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres"

# Credenciales de RabbitMQ (servicio `rabbitmq` — RABBITMQ_DEFAULT_USER/PASS).
# Sin esto la imagen oficial cae a `guest/guest`, alcanzable por cualquiera
# con acceso a la red si el puerto 5672/15672 queda expuesto (ver [S-12]).
# `web`, `execution-consumer` y `engine` arman su RABBITMQ_URL con estos
# mismos valores.
# IMPORTANTE: estos valores se interpolan dentro de una URL
# (amqp://USER:PASS@rabbitmq:5672), así que usar solo caracteres seguros para
# URL (letras, números, `.`, `_`, `~`, `-`). Una `ñ`, un `@`, un `/`, un `:` o
# un `#` rompen la conexión con ACCESS_REFUSED. Generar con: openssl rand -hex 24
RABBITMQ_USER="vortest"
RABBITMQ_PASS="cambia-esta-contrasena-segura"
