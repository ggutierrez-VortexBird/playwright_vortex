# Imagen liviana para web y execution-consumer (no lanzan navegadores; el grabador usa Dockerfile)
FROM node:24-slim AS deps

WORKDIR /app

# openssl lo requiere Prisma y node:slim no lo trae
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY scripts ./scripts
RUN npm ci

COPY . .

RUN npx prisma generate

FROM node:24-slim AS runner

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=deps /app ./

# Chromium headless para renderizar el PDF del Acta
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npx playwright install --with-deps chromium-headless-shell \
    && chmod -R a+rX /ms-playwright \
    && rm -rf /var/lib/apt/lists/*

# chown solo de las carpetas que se escriben; next dev necesita escribir en .next, next-env.d.ts y tsconfig.json
RUN mkdir -p /app/playwright-scripts /app/storage/actas /app/storage/artefactos /app/.next \
    && chown -R node:node /app/playwright-scripts /app/storage /app/.next \
    && chown node:node /app/next-env.d.ts /app/tsconfig.json
USER node

EXPOSE 3000

# El compose define el command de cada servicio
