# Valores NO secretos para correr el grabador en el host contra el stack de Docker (npm run dev:recorder:host).
# Los secretos salen de ../.env, el mismo archivo que usa docker compose, así coinciden con los contenedores.
DATABASE_URL=postgresql://vortest:vortest@localhost:5432/vortest?schema=public
RECORDER_WS_PORT=3100
RECORDER_PUBLIC_URL=ws://localhost:3100
