{
  "name": "vortest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,consumer,recorder -c blue,magenta,green \"next dev --turbo\" \"node --import tsx scripts/execution-consumer.ts\" \"node --import tsx scripts/recorder-worker.ts\"",
    "dev:web": "next dev --turbo",
    "dev:consumer": "node --import tsx scripts/execution-consumer.ts",
    "dev:recorder": "node --import tsx scripts/recorder-worker.ts",
    "dev:recorder:host": "node --env-file=../.env --env-file=recorder-host.env --import tsx scripts/recorder-worker.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:playwright": "node scripts/verify-playwright-version.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test -c playwright.e2e.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "verify:hu-g21-schema": "tsx scripts/verify-hu-g21-schema.ts",
    "cleanup:sesiones": "node --import tsx scripts/cleanup-sesiones.ts",
    "consumer": "node --import tsx scripts/execution-consumer.ts",
    "recorder": "node --import tsx scripts/recorder-worker.ts",
    "postinstall": "node scripts/install-playwright-browsers.js"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-switch": "^1.3.7",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.9",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "iron-session": "^8.0.4",
    "lucide-react": "^0.468.0",
    "next": "^16.3.6",
    "playwright": "1.62.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.6.0",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.49",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "whatwg-fetch": "^3.6.20"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
