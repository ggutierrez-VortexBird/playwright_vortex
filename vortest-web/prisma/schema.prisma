// Schema Prisma de VorTest: Postgres 16+, UUID v4; Restrict en PKs de evidencia, Cascade en filas hijas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums nativos Postgres

enum EjecucionEstado {
  pendiente
  corriendo
  paso
  fallo
  errorMotor
  cancelado
}

enum PasoEjecucionEstado {
  paso
  fallo
}

enum ArtefactoTipo {
  video
  captura
  trace
}

enum CasoOrigen {
  subirScript
  grabador
  mixto
}

// Roles jerárquicos: superadmin (todo), admin (Espacios asignados), tester (Proyectos asignados)
enum Rol {
  superadmin
  admin
  tester
}

// Identidad y membresía

model Usuario {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  rol            Rol       @default(tester)
  /// Nombre para mostrar, editable desde /perfil; opcional.
  nombre         String?
  /// Suspender = false. Un usuario suspendido no puede iniciar sesión.
  activo         Boolean   @default(true)
  ultimoAccesoAt DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  espacios       UsuarioEspacio[]
  proyectos      UsuarioProyecto[]
  casosAsignados CasoPrueba[]      @relation("CasoPruebaResponsable")
  sesiones       SesionGrabacion[]

  @@index([email])
}

model Espacio {
  id        String   @id @default(uuid())
  nombre    String
  color     String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  proyectos Proyecto[]
  miembros  UsuarioEspacio[]
}

model UsuarioEspacio {
  usuarioId String
  espacioId String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  espacio Espacio @relation(fields: [espacioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, espacioId])
  @@index([espacioId])
}

// Jerarquía espacio → proyecto → caso de prueba

model Proyecto {
  id             String   @id @default(uuid())
  espacioId      String
  nombre         String
  ambiente       String
  descripcion    String?
  versionSistema String?
  color          String?
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  espacio      Espacio           @relation(fields: [espacioId], references: [id], onDelete: Restrict)
  casosPrueba  CasoPrueba[]
  credenciales Credencial[]
  sesiones     SesionGrabacion[]
  testers      UsuarioProyecto[]

  @@index([espacioId])
}

// Tester↔proyecto: un tester solo opera los Proyectos donde tiene una fila aquí
model UsuarioProyecto {
  usuarioId  String
  proyectoId String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, proyectoId])
  @@index([proyectoId])
}

model CasoPrueba {
  id             String     @id @default(uuid())
  proyectoId     String
  codigo         String
  nombre         String
  script         String     @db.Text
  scriptFileName String?
  responsableId  String
  origen         CasoOrigen @default(subirScript)
  /// Caso padre (opcional): se ejecuta antes de este caso y su storageState se inyecta en el navegador.
  parentCaseId   String?
  activo         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(6)

  proyecto      Proyecto             @relation(fields: [proyectoId], references: [id], onDelete: Restrict)
  responsable   Usuario              @relation("CasoPruebaResponsable", fields: [responsableId], references: [id], onDelete: Restrict)
  parentCase    CasoPrueba?          @relation("CasoPadreHijo", fields: [parentCaseId], references: [id], onDelete: SetNull)
  childCases    CasoPrueba[]         @relation("CasoPadreHijo")
  sesionesPadre SesionGrabacion[]    @relation("SesionPadre")
  ejecuciones   Ejecucion[]
  sesiones      SesionGrabacion[]
  pasosGrabados PasoGrabado[]
  parametros    ParametroGrabacion[]
  juegosDeDatos JuegoDeDatos[]

  @@unique([proyectoId, codigo])
  @@index([responsableId])
  @@index([proyectoId])
  @@index([origen])
  @@index([parentCaseId])
}

// Ejecución, pasos, artefactos

model Ejecucion {
  id               String          @id @default(uuid())
  casoPruebaId     String
  estado           EjecucionEstado
  inicioAt         DateTime?
  finAt            DateTime?
  duracionMs       Int?
  errorMsg         String?
  entorno          String?
  navegador        String?
  sistemaOperativo String?
  nodoEjecucion    String?
  loteId           String?
  /// storageState capturado tras una ejecución exitosa; lo usan los casos hijos.
  storageState     Json?
  asercionesTotal  Int             @default(0)
  asercionesOk     Int             @default(0)
  asercionesFail   Int             @default(0)
  /// Si es un padre sintetizado, id de la Ejecucion hija que espera su `end`; campo interno, nunca expuesto en UI/API.
  pendingChildEjecucionId String?
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(6)

  casoPrueba  CasoPrueba      @relation(fields: [casoPruebaId], references: [id], onDelete: Restrict)
  pasos       PasoEjecucion[]
  subacciones PasoSubaccion[]
  artefactos  Artefacto[]
  acta        Acta?

  @@index([estado, inicioAt])
  @@index([loteId])
  @@index([casoPruebaId, estado])
  @@index([casoPruebaId, finAt])
  @@index([createdAt])
}

model PasoEjecucion {
  id                String              @id @default(uuid())
  ejecucionId       String
  numero            Int
  descripcion       String
  estado            PasoEjecucionEstado
  duracionMs        Int?
  errorMsg          String?
  resultadoEsperado String?
  resultadoObtenido String?
  errorCount        Int                 @default(0)
  logs              Json?
  videoInicioMs     Int?
  videoFinMs        Int?
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)

  ejecucion   Ejecucion       @relation(fields: [ejecucionId], references: [id], onDelete: Cascade)
  artefactos  Artefacto[]
  subacciones PasoSubaccion[]

  @@unique([ejecucionId, numero])
}

model PasoSubaccion {
  id                  String              @id @default(uuid())
  ejecucionId         String
  pasoEjecucionId     String
  numero              Int
  tipo                String              @default("other")
  descripcion         String
  estado              PasoEjecucionEstado
  duracionMs          Int?
  errorMsg            String?
  logs                Json?
  capturaActualId     String?
  capturaReferenciaId String?
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)

  ejecucion         Ejecucion     @relation(fields: [ejecucionId], references: [id], onDelete: Cascade)
  pasoEjecucion     PasoEjecucion @relation(fields: [pasoEjecucionId], references: [id], onDelete: Cascade)
  capturaActual     Artefacto?    @relation("CapturaActual", fields: [capturaActualId], references: [id])
  capturaReferencia Artefacto?    @relation("CapturaReferencia", fields: [capturaReferenciaId], references: [id])

  @@index([ejecucionId])
  @@index([pasoEjecucionId, numero])
}

model Artefacto {
  id              String        @id @default(uuid())
  ejecucionId     String
  pasoEjecucionId String?
  tipo            ArtefactoTipo
  nombre          String
  path            String
  sha256          String
  bytes           Int
  metadata        Json?
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)

  ejecucion          Ejecucion       @relation(fields: [ejecucionId], references: [id], onDelete: Cascade)
  pasoEjecucion      PasoEjecucion?  @relation(fields: [pasoEjecucionId], references: [id], onDelete: SetNull)
  capturasActuales   PasoSubaccion[] @relation("CapturaActual")
  capturasReferencia PasoSubaccion[] @relation("CapturaReferencia")

  @@index([ejecucionId])
  @@index([tipo])
  @@index([pasoEjecucionId])
}

// Acta de evidencia (1-a-1 con ejecución)

model Acta {
  id          String    @id @default(uuid())
  ejecucionId String    @unique
  consecutivo String    @unique
  rutaPdf     String
  generatedAt DateTime?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  ejecucion Ejecucion @relation(fields: [ejecucionId], references: [id], onDelete: Restrict)
}

// Credenciales

model Credencial {
  id            String    @id @default(uuid())
  proyectoId    String
  nombre        String
  tipo          String
  valor         Bytes     @db.ByteA
  sesionVenceAt DateTime?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  proyecto Proyecto          @relation(fields: [proyectoId], references: [id], onDelete: Restrict)
  sesiones SesionGrabacion[]

  @@index([proyectoId])
}

// Modo grabador; SesionGrabacion: un intento de grabación (token HMAC reutilizable para reconexión)

model SesionGrabacion {
  id              String    @id @default(uuid())
  proyectoId      String
  usuarioId       String
  casoPruebaId    String?
  /// Caso padre (ej. login) que se ejecuta antes de grabar para obtener un storageState fresco.
  parentCaseId    String?
  nombre          String
  urlInicial      String
  ambiente        String
  navegador       String    @default("chromium")
  credencialId    String?
  storageState    Json?
  token           String?
  tokenUsado      Boolean   @default(false)
  estado          String
  mensajeError    String?
  /// Spec crudo de codegen: fuente de verdad del script (los PasoGrabado son solo un parseo de apoyo).
  specCode        String?   @db.Text
  /// Ruta absoluta del .spec.ts de codegen; vive en el tempdir del SO y se pierde al reiniciar.
  codegenFilePath String?
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  proyecto   Proyecto             @relation(fields: [proyectoId], references: [id], onDelete: Restrict)
  usuario    Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  casoPrueba CasoPrueba?          @relation(fields: [casoPruebaId], references: [id], onDelete: SetNull)
  parentCase CasoPrueba?          @relation("SesionPadre", fields: [parentCaseId], references: [id], onDelete: SetNull)
  credencial Credencial?          @relation(fields: [credencialId], references: [id], onDelete: SetNull)
  pasos      PasoGrabado[]
  parametros ParametroGrabacion[]

  @@index([proyectoId])
  @@index([usuarioId])
  @@index([estado])
  @@index([casoPruebaId])
  @@index([parentCaseId])
}

// PasoGrabado: unidad mínima del modo grabador, persistida mientras la grabación está activa

model PasoGrabado {
  id                 String   @id @default(uuid())
  sesionId           String
  casoPruebaId       String?
  numero             Int
  tipo               String
  origen             String   @default("grabado")
  descripcion        String
  selectorPrincipal  Json
  valor              String?
  esValorSensible    Boolean  @default(false)
  assertionKind      String?
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  sesion     SesionGrabacion @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  casoPrueba CasoPrueba?     @relation(fields: [casoPruebaId], references: [id], onDelete: SetNull)

  @@unique([sesionId, numero])
  @@index([sesionId])
  @@index([casoPruebaId])
}

// ParametroGrabacion: clave/valor de la grabación; origen='credencial' = valor de Credencial.valor descifrado

model ParametroGrabacion {
  id           String   @id @default(uuid())
  sesionId     String?
  casoPruebaId String?
  nombre       String
  valorDefecto String?
  origen       String
  credencialId String?
  enUso        Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  sesion     SesionGrabacion? @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  casoPrueba CasoPrueba?      @relation(fields: [casoPruebaId], references: [id], onDelete: Cascade)

  @@unique([sesionId, nombre])
  @@index([casoPruebaId])
}

// JuegoDeDatos: datos tabulares para ejecución data-driven (stub)

model JuegoDeDatos {
  id            String   @id @default(uuid())
  casoPruebaId  String
  nombreArchivo String
  filas         Json
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  casoPrueba CasoPrueba @relation(fields: [casoPruebaId], references: [id], onDelete: Cascade)

  @@index([casoPruebaId])
}

// Correlativo anual atómico

model ConsecutivoAnual {
  anio   Int @id
  ultimo Int
}

// Rate limiting de login

model IntentoLogin {
  id        String   @id @default(uuid())
  clave     String   @unique  // hash de IP + email
  intentos  Int      @default(1)
  ventanaAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([ventanaAt])
}
