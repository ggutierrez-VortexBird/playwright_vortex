# Base de datos
DATABASE_URL="postgresql://vortest:vortest@localhost:5432/vortest?schema=public"

# Sesiones (iron-session) — mínimo 32 caracteres
SESSION_SECRET="cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres"

# Semilla de superadmin
SEED_ADMIN_PASSWORD="cambia-esta-contraseña-segura"

# Entorno
NODE_ENV="development"

# ============================================================
# Recorder-worker (HU-G22) — modo grabador
# ============================================================

# Puerto HTTP + WS del recorder-worker
RECORDER_WS_PORT=3100

# URL pública del WS (expuesta al browser del frontend)
RECORDER_PUBLIC_URL=ws://localhost:3100

# URL interna del recorder-worker — la usa Next.js (Server Action) para
# llamar a /internal/start. En dev local apunta al worker local; en Docker
# Compose debe apuntar al nombre del servicio (http://recorder:3100).
RECORDER_INTERNAL_URL=http://localhost:3100

# Secreto compartido entre Next.js y recorder-worker para /internal/start
# DEBE coincidir en ambos servicios. Generar con: openssl rand -hex 32
RECORDER_INTERNAL_SECRET=""

# Máximo de sesiones de grabación concurrentes (default 3)
RECORDER_MAX_SESSIONS=3

# Timeout de heartbeat en ms (default 600000 = 10 min)
RECORDER_HEARTBEAT_TIMEOUT_MS=600000

# ============================================================
# Motor de ejecución (Fase 1 — vortest-engine, RabbitMQ) — usado por
# lib/ejecuciones/actions.ts (dispatch + cancelación) y por
# scripts/execution-consumer.ts (consume engine.events, dev:consumer)
# ============================================================

# URL de conexión a RabbitMQ (colas engine.execute / engine.events).
# En dev local sin Docker apunta a un RabbitMQ corriendo en el host (con las
# credenciales que le hayas configurado ahí — la imagen oficial por defecto
# usa guest/guest, pero eso es inseguro si el broker es alcanzable por red,
# ver [S-12]). En Docker Compose apunta al servicio `rabbitmq`, que en este
# repo NO usa guest/guest — ver RABBITMQ_USER/RABBITMQ_PASS en el
# .env.example de la raíz del repo.
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Secreto compartido con vortest-engine para los endpoints internos
# motor<->app (subida de artefactos, cancelación). DEBE coincidir con
# ENGINE_INTERNAL_SECRET en vortest-engine/.env.
# Generar con: openssl rand -hex 32
ENGINE_INTERNAL_SECRET="cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres"

# URL interna de vortest-engine — la usa detenerEjecucion para
# POST /internal/cancel/:ejecucionId. En dev local sin Docker apunta al
# motor local; en Docker Compose apunta al nombre del servicio
# (http://engine:3001).
ENGINE_INTERNAL_URL=http://localhost:3001

# Timeout global de una ejecución en ms (default 600000 = 10 min) — se manda
# en cada ExecuteJobMessage.timeoutMs; el motor ya no lo hardcodea.
EJECUCION_TIMEOUT_MS=600000

# ============================================================
# Limpieza de sesiones de grabación (HU-GR-1, scripts/cleanup-sesiones.ts)
# ============================================================

# Días de retención antes de purgar SesionGrabacion en estados terminales
# ('descartada' o 'guardada'). Default 7 si no se define. Pensado para
# correr como cron diario (ver el header de scripts/cleanup-sesiones.ts).
SESIONES_RETENTION_DAYS=7
