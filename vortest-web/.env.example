# Base de datos
DATABASE_URL="postgresql://vortest:vortest@localhost:5432/vortest?schema=public"

# Secreto de sesiones (iron-session), mínimo 32 caracteres
SESSION_SECRET="cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres"

# Contraseña del superadmin inicial
SEED_ADMIN_PASSWORD="cambia-esta-contraseña-segura"

NODE_ENV="development"

# Grabador

# Puerto HTTP + WS del grabador
RECORDER_WS_PORT=3100

# URL pública del WS (la usa el navegador)
RECORDER_PUBLIC_URL=ws://localhost:3100

# URL interna del grabador (en Docker Compose, http://recorder:3100)
RECORDER_INTERNAL_URL=http://localhost:3100

# Secreto compartido web↔grabador; generar con: openssl rand -hex 32
RECORDER_INTERNAL_SECRET=""

# Máximo de sesiones de grabación concurrentes
RECORDER_MAX_SESSIONS=3

# Timeout de heartbeat en ms (10 min)
RECORDER_HEARTBEAT_TIMEOUT_MS=600000

# Motor de ejecución

# URL de RabbitMQ (en Docker Compose, las credenciales salen del .env de la raíz)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Secreto compartido con vortest-engine; generar con: openssl rand -hex 32
ENGINE_INTERNAL_SECRET="cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres"

# URL interna del motor (en Docker Compose, http://engine:3001)
ENGINE_INTERNAL_URL=http://localhost:3001

# Timeout global de una ejecución en ms (10 min)
EJECUCION_TIMEOUT_MS=600000

# Días de retención de sesiones de grabación terminales (scripts/cleanup-sesiones.ts)
SESIONES_RETENTION_DAYS=7

# Clave de cifrado de credenciales, mínimo 32 caracteres; obligatoria en producción. Generar con: openssl rand -hex 32
CREDENCIALES_ENCRYPTION_KEY=""

# Idioma y zona horaria del navegador del grabador; deben coincidir con las del motor
PLAYWRIGHT_LOCALE=es-CO
PLAYWRIGHT_TIMEZONE=America/Bogota
