# URL de conexión a RabbitMQ (colas engine.execute / engine.events / engine.execute.dlq).
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Secreto compartido con vortest-web para los endpoints internos motor<->app
# (subida de artefactos, cancelación). DEBE coincidir con ENGINE_INTERNAL_SECRET
# en vortest-web. Generar con: openssl rand -hex 32
ENGINE_INTERNAL_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres

# URL interna de vortest-web, usada para subir artefactos (POST /internal/artefactos/upload)
# y (en el futuro) cualquier otra llamada HTTP motor -> app.
MAIN_APP_INTERNAL_URL=http://localhost:3000

# Puerto del servidor HTTP interno de este servicio (health check, ready, cancelación).
PORT=3001

# FIA-02: jobs simultáneos máximo por réplica del motor.
# Dimensionar según memoria disponible (~300-500 MB por Chromium).
# Coherente con los límites de cpu/memoria del contenedor.
ENGINE_MAX_CONCURRENT_JOBS=3

# FIA-08: grace period antes de matar procesos activos durante apagado (ms).
ENGINE_SHUTDOWN_GRACE_MS=0

# PW-02: zona horaria y locale del navegador simulado.
# Defaults a America/Bogota/es-CO (coherente con el locale es-CO).
PLAYWRIGHT_TIMEZONE=America/Bogota
PLAYWRIGHT_LOCALE=es-CO
