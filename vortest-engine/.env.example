# URL de RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Secreto compartido con vortest-web; generar con: openssl rand -hex 32
ENGINE_INTERNAL_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres

# URL interna de vortest-web, para subir artefactos
MAIN_APP_INTERNAL_URL=http://localhost:3000

# Puerto HTTP interno
PORT=3001

# Jobs simultáneos por réplica (~300-500 MB por Chromium)
ENGINE_MAX_CONCURRENT_JOBS=3

# Espera antes de matar procesos activos al apagar (ms)
ENGINE_SHUTDOWN_GRACE_MS=0

# Zona horaria y locale del navegador simulado
PLAYWRIGHT_TIMEZONE=America/Bogota
PLAYWRIGHT_LOCALE=es-CO
